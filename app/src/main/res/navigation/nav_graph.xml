<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/projectListFragment">

    <fragment
        android:id="@+id/projectListFragment"
        android:name="com.buildvisionai.ui.projects.ProjectListFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_projects_to_editor"
            app:destination="@id/editorFragment" />
        <action
            android:id="@+id/action_projects_to_versions"
            app:destination="@id/versionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.buildvisionai.ui.editor.EditorFragment"
        android:label="@string/editor_title">
        <argument
            android:name="versionId"
            app:argType="string" />
        <action
            android:id="@+id/action_editor_to_estimate"
            app:destination="@id/estimateFragment" />
        <action
            android:id="@+id/action_editor_to_versions"
            app:destination="@id/versionsFragment" />
        <action
            android:id="@+id/action_editor_to_editor"
            app:destination="@id/editorFragment"
            app:popUpTo="@id/editorFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/estimateFragment"
        android:name="com.buildvisionai.ui.estimate.EstimateFragment"
        android:label="@string/estimate_title">
        <argument
            android:name="versionId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/versionsFragment"
        android:name="com.buildvisionai.ui.versions.VersionsFragment"
        android:label="@string/versions_title">
        <argument
            android:name="projectId"
            app:argType="string" />
        <argument
            android:name="versionId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_versions_to_editor"
            app:destination="@id/editorFragment"
            app:popUpTo="@id/editorFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
